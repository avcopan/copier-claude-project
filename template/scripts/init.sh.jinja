#!/usr/bin/env bash

# Install the Pixi environment (this creates pixi.lock, so it goes in the initial commit)
pixi install

# Initialize git repository, unless this is already one (e.g. a clone of an existing project)
if [[ -e .git ]]; then
  NEW_REPO=false
  echo "Already a Git repository: skipping git init and the initial commit."
else
  NEW_REPO=true
  git init -b main
  git add --all
  if git config --get user.name >/dev/null 2>&1 && git config --get user.email >/dev/null 2>&1; then
    git commit -m "Initial commit"
  else
    echo "Warning: Git author identity is not configured."
    echo "You can configure it as follows:"
    echo '  git config --global user.name "Your Name"'
    echo '  git config --global user.email "you@example.com"'
    echo "Afterwards, you can make the initial commit with:"
    echo '  git commit -m "Initial commit"'
  fi
fi

# Clone the code repos listed in repos.txt
pixi run bootstrap

echo "Setup complete."
if $NEW_REPO; then
  echo
  echo "Now, create an empty private repository named {{project_name}} on GitHub"
  echo "(without a README, license, or .gitignore), and run the following commands:"
  echo "  git remote add origin git@github.com:{{github_org_name}}/{{project_name}}.git"
  echo "  git push -u origin main"
fi
